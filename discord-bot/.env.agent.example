# Loop intelligence runtime (operator-only example; do not commit real credentials)
#
# The OpenAI-compatible endpoint below is the OpenCode LLM proxy
# (github.com/KochC/opencode-llm-proxy). Start OpenCode with the proxy plugin
# enabled and add as many profiles as you have model access to. Use the model
# IDs reported by `GET http://127.0.0.1:4010/v1/models`.
MODEL_PROFILES_JSON=[{"id":"proxy-primary","endpoint":"http://127.0.0.1:4010/v1","apiKey":"","model":"github-copilot/claude-sonnet-4.6","capabilities":["conversation","planning","critic","research","coding"],"contextWindow":200000,"quality":0.9,"inputCostPerMillion":0,"outputCostPerMillion":0,"latencyMs":2500,"priority":1}]
MODEL_MAX_RETRIES=2
MODEL_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_RESET_MS=60000
AGENT_BUDGET_USD=5

# Semantic memory (RAG). Nomic Embed Text is the default provider:
#   https://atlas.nomic.ai/atlas-api  ->  EMBED_BASE_URL=https://api.nomic.ai/v1
# Leave EMBED_API_KEY empty to run with relational memory only (RAG disabled).
EMBED_BASE_URL=https://api.nomic.ai/v1
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text-v1.5
EMBED_DIMENSIONS=768
MEMORY_SEARCH_LIMIT=8
MEMORY_INGESTION=true

RESEARCH_MAX_BYTES=10485760
RESEARCH_TIMEOUT_MS=20000
RESEARCH_ALLOWED_TYPES=text/html,text/plain,application/json,application/pdf
RESEARCH_ALLOWED_HOSTS=
CODE_WORKSPACE_ROOT=.
CODE_VALIDATION_COMMANDS_JSON=["npm test","npm run check"]
CODE_COMMAND_TIMEOUT_MS=120000
