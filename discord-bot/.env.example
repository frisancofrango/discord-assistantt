# Copy this file to `.env` and fill in your Discord credentials.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Your application (client) ID
CLIENT_ID=1536986943760375868

# The guild (server) ID used for instant command deployment during development.
GUILD_ID=1536902502870421544

# Channel ID where moderation actions are logged.
MOD_LOG_CHANNEL_ID=

# Set true to (re)deploy slash commands every start (idempotent).
DEPLOY_COMMANDS_ON_START=false

# OpenCode Free Public Unlimited AI Model Profiles
MODEL_PROFILES_JSON=[{"id":"opencode-proxy-free","endpoint":"http://127.0.0.1:4010/v1","apiKey":"","model":"opencode/deepseek-v4-flash-free","capabilities":["conversation","planning","critic","research","coding"],"contextWindow":128000,"quality":0.95,"inputCostPerMillion":0,"outputCostPerMillion":0,"latencyMs":600,"priority":10,"enabled":true,"kind":"http"},{"id":"opencode-zen-free","endpoint":"http://127.0.0.1:3000/v1","apiKey":"sk-opencode-zen-keyless-fake-99999","model":"mimo-v2.5-free","capabilities":["conversation","planning","critic","research","coding"],"contextWindow":128000,"quality":0.9,"inputCostPerMillion":0,"outputCostPerMillion":0,"latencyMs":800,"priority":8,"enabled":true,"kind":"http"},{"id":"opencode-cli-direct","endpoint":"http://127.0.0.1:4010/v1","apiKey":"","model":"opencode/deepseek-v4-flash-free","capabilities":["conversation","planning","critic","research","coding"],"contextWindow":128000,"quality":0.85,"inputCostPerMillion":0,"outputCostPerMillion":0,"latencyMs":1200,"priority":5,"enabled":true,"kind":"cli"}]
MODEL_MAX_RETRIES=2
MODEL_PACING_MS=0
MODEL_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_RESET_MS=60000
AGENT_BUDGET_USD=999999
RACE_PROFILES=2

# Semantic memory (RAG)
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONS=768
MEMORY_SEARCH_LIMIT=8
MEMORY_INGESTION=true

# Native systems defaults
TICKET_OPEN_LIMIT=3
TICKET_SLA_MINUTES=60
VERIFICATION_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFIED_ROLE_ID=
QUARANTINE_ROLE_ID=
INVENTORY_RESERVATION_MINUTES=15
MARKETING_MAX_RATE_PER_MINUTE=30
ANALYTICS_RETENTION_DAYS=180
