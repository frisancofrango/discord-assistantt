# Copy this file to `.env` and fill in the values.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Your application (client) ID
CLIENT_ID=your-application-id-here

# The guild (server) ID used for instant command deployment during development.
# Leave blank to deploy commands globally (can take up to 1 hour to appear).
GUILD_ID=your-dev-guild-id-here

# Channel ID where moderation actions are logged.
MOD_LOG_CHANNEL_ID=your-mod-log-channel-id-here

# Set true to (re)deploy slash commands every start (idempotent).
DEPLOY_COMMANDS_ON_START=false

# Semantic memory (RAG). Defaults to Nomic Embed Text via the
# OpenAI-compatible endpoint below; leave EMBED_API_KEY empty to disable RAG.
EMBED_BASE_URL=https://api.nomic.ai/v1
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text-v1.5
EMBED_DIMENSIONS=768
MEMORY_SEARCH_LIMIT=8
MEMORY_INGESTION=true

# Native systems (IDs are optional until configured per server)
TICKET_OPEN_LIMIT=3
TICKET_SLA_MINUTES=60
VERIFICATION_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFIED_ROLE_ID=
QUARANTINE_ROLE_ID=
INVENTORY_RESERVATION_MINUTES=15
MARKETING_MAX_RATE_PER_MINUTE=30
ANALYTICS_RETENTION_DAYS=180
