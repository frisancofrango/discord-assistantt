NODE_ENV=production
LOG_LEVEL=info
DISCORD_TOKEN=replace_me
CLIENT_ID=replace_me
GUILD_ID=
MOD_LOG_CHANNEL_ID=
DEPLOY_COMMANDS_ON_START=true
DATABASE_URL=postgresql://loop:replace_me@postgres:5432/loop
DATABASE_SSL=false
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=loop
QUEUE_CONCURRENCY=5
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
RUN_MIGRATIONS=true
REQUIRE_DEPENDENCIES=true
SHUTDOWN_TIMEOUT_MS=15000

# Semantic memory (RAG) — Nomic Embed Text via the OpenAI-compatible endpoint.
# Leave EMBED_API_KEY empty to run with relational memory only.
EMBED_BASE_URL=https://api.nomic.ai/v1
EMBED_API_KEY=replace_me
EMBED_MODEL=nomic-embed-text-v1.5
EMBED_DIMENSIONS=768
MEMORY_SEARCH_LIMIT=8
MEMORY_INGESTION=true
TICKET_OPEN_LIMIT=3
TICKET_DUPLICATE_MINUTES=10
TICKET_SLA_MINUTES=60
VERIFICATION_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFIED_ROLE_ID=
QUARANTINE_ROLE_ID=
INVENTORY_RESERVATION_MINUTES=15
ACCEPTABLE_USE_VERSION=1
MARKETING_MAX_RATE_PER_MINUTE=30
ANALYTICS_RETENTION_DAYS=180
POSTGRES_PASSWORD=replace_with_a_long_random_password
