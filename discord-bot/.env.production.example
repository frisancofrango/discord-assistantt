NODE_ENV=production
LOG_LEVEL=info
DISCORD_TOKEN=replace_me
CLIENT_ID=replace_me
GUILD_ID=
MOD_LOG_CHANNEL_ID=
DATABASE_URL=postgresql://azure:replace_me@postgres:5432/azure
DATABASE_SSL=false
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=azure
QUEUE_CONCURRENCY=5
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
RUN_MIGRATIONS=true
REQUIRE_DEPENDENCIES=true
SHUTDOWN_TIMEOUT_MS=15000
TICKET_OPEN_LIMIT=3
TICKET_DUPLICATE_MINUTES=10
TICKET_SLA_MINUTES=60
VERIFICATION_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFIED_ROLE_ID=
QUARANTINE_ROLE_ID=
INVENTORY_RESERVATION_MINUTES=15
ACCEPTABLE_USE_VERSION=1
MARKETING_MAX_RATE_PER_MINUTE=30
ANALYTICS_RETENTION_DAYS=180
POSTGRES_PASSWORD=replace_with_a_long_random_password
